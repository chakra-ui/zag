{
  "name": "@zag-js/codemod",
  "version": "2.0.0-next.3",
  "description": "Codemods for upgrading zag.js projects between major versions",
  "keywords": [
    "zag",
    "codemod",
    "migration",
    "upgrade"
  ],
  "author": "Segun Adebayo <sage@adebayosegun.com>",
  "homepage": "https://github.com/chakra-ui/zag#readme",
  "license": "MIT",
  "repository": "https://github.com/chakra-ui/zag/tree/main/packages/codemod",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "zag-codemod": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/chakra-ui/zag/issues"
  },
  "clean-package": "../../clean-package.config.json",
  "main": "src/index.ts",
  "dependencies": {
    "@babel/parser": "7.29.11",
    "magic-string": "0.30.21"
  },
  "devDependencies": {
    "clean-package": "2.2.0"
  }
}
