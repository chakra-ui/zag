    {
      "from": "inactive",
      "to": "idle",
      "event": "AVAILABILITY.CHANGED",
      "guard": "canObserve"
    },
    {
      "from": "inactive",
      "to": "loading",
      "event": "LOAD.REQUESTED",
      "guard": "hasMore"
    },
    {
      "from": "inactive",
      "to": "idle",
      "event": "RESET",
      "guard": "canObserve"
    },
    {
      "from": "loading",
      "to": "idle",
      "event": "COUNT.CHANGED",
      "guard": "isLoadSettled && canObserve"
    },
    {
      "from": "loading",
      "to": "inactive",
      "event": "COUNT.CHANGED",
      "guard": "isLoadSettled"
    },
    {
      "from": "loading",
      "to": "idle",
      "event": "LOAD.DONE",
      "guard": "canObserve"
    },
    {
      "from": "loading",
      "to": "inactive",
      "event": "LOAD.DONE",
      "guard": null
    }
