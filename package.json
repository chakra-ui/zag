{
  "name": "@zag-js/org",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chakra-ui/zag.git"
  },
  "author": "Segun Adebayo <sage@adebayosegun.com>",
  "license": "MIT",
  "scripts": {
    "packages": "pnpm --filter=./packages/** -r",
    "build": "pnpm packages -- build",
    "postbuild": "pnpm document-types && pnpm document-attr && pnpm document-css-vars",
    "prepare": "husky",
    "sync-pkgs": "tsx scripts/sync-packages.ts",
    "clean-pkgs": "pnpm -r exec rm -rf dist .swc *.log",
    "clean": "pnpm clean-pkgs && rm -rf node_modules",
    "react": "pnpm --filter \"./examples/next-ts\"",
    "vue": "pnpm --filter \"./examples/nuxt-ts\"",
    "solid": "pnpm --filter \"./examples/solid-ts\"",
    "svelte": "pnpm --filter \"./examples/svelte-ts\"",
    "preact": "pnpm --filter \"./examples/preact-ts\"",
    "vanilla": "pnpm --filter \"./examples/vanilla-ts\"",
    "start-react": "pnpm react dev",
    "start-vue": "pnpm vue dev",
    "start-solid": "pnpm solid dev",
    "start-svelte": "pnpm svelte dev",
    "start-preact": "pnpm preact dev",
    "start-vanilla": "pnpm vanilla dev",
    "start-website": "pnpm website dev",
    "pw-report": "playwright show-report e2e/report",
    "pw-test": "cross-env FRAMEWORK=${FRAMEWORK:-react} playwright test",
    "pw-test-debug": "cross-env FRAMEWORK=${FRAMEWORK:-react} playwright test --debug",
    "pw-test-ui": "cross-env FRAMEWORK=react playwright test --ui",
    "e2e-react": "cross-env FRAMEWORK=react playwright test",
    "e2e-vue": "cross-env FRAMEWORK=vue playwright test",
    "e2e-solid": "cross-env FRAMEWORK=solid playwright test",
    "e2e-svelte": "cross-env FRAMEWORK=svelte playwright test",
    "e2e-preact": "cross-env FRAMEWORK=preact playwright test",
    "generate-machine": "plop machine && pnpm sync-pkgs",
    "generate-util": "plop utility && pnpm sync-pkgs",
    "typecheck": "pnpm packages -- typecheck",
    "lint": "oxlint",
    "version": "changeset version",
    "release": "changeset publish",
    "version-snapshot": "changeset version --snapshot v1-beta",
    "release-snapshot": "changeset publish --tag v1-beta",
    "test-js": "vitest packages/utilities packages/core packages/machines/color-picker packages/machines/number-flow packages/machines/infinite-scroll packages/machines/field --passWithNoTests",
    "test-react": "cd packages/frameworks/react && pnpm exec vitest --passWithNoTests",
    "test-svelte": "cd packages/frameworks/svelte && pnpm exec vitest --passWithNoTests",
    "test-solid": "cd packages/frameworks/solid && pnpm exec vitest --passWithNoTests",
    "test-vue": "cd packages/frameworks/vue && pnpm exec vitest --passWithNoTests",
    "test-preact": "cd packages/frameworks/preact && pnpm exec vitest --passWithNoTests",
    "test-vanilla": "cd packages/frameworks/vanilla && pnpm exec vitest --passWithNoTests",
    "test": "pnpm test-js --run && pnpm test-react --run && pnpm test-svelte --run && pnpm test-solid --run && pnpm test-vue --run && pnpm test-vanilla --run",
    "slack": "tsx scripts/slack.ts",
    "play": "tsx scripts/play.ts",
    "document-types": "tsx scripts/typedocs.ts",
    "document-attr": "tsx scripts/data-attr.ts",
    "document-css-vars": "tsx scripts/css-vars.ts",
    "check-type-exports": "tsx scripts/check-type-exports.ts",
    "website": "pnpm --filter=./website",
    "format": "oxfmt .",
    "format-check": "oxfmt --check ."
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx,vue,svelte,yml,yaml,html}": "oxfmt"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@internationalized/date": "3.12.3",
    "@playwright/test": "1.62.1",
    "@swc/core": "1.16.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "25.9.5",
    "@types/signale": "1.4.7",
    "commitlint": "21.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "fast-glob": "3.3.3",
    "find-packages": "10.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "node-fetch": "3.3.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "plop": "4.0.5",
    "scule": "1.3.0",
    "signale": "1.4.0",
    "ts-morph": "28.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
